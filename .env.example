# DevMng 환경 변수 예시. 실제 값은 .env(저장소에서 제외됨)나 셸 환경 변수로 설정한다.
# 값에 # 이 들어 있으면 큰따옴표로 감싼다.

# BotMng 주소 (예: https://botmng.example.com)
# 컨테이너 안에서 127.0.0.1 은 컨테이너 자신이다. 호스트의 BotMng 는 host.docker.internal 로 접속하되,
# BotMng 인증서가 공인 인증서가 아니면(자체 서명, Cloudflare Origin) 연결이 거부되므로 공개 주소를 쓴다.
BOTMNG_URL=
# BotMng 서비스 계정(devmng) 비밀번호. BotMng 서버 .env의 DEVMNG_PASSWORD와 같은 값
BOTMNG_SERVICE_PASSWORD=
# docker compose 로 실행할 때의 Postgres 비밀번호 (필수)
POSTGRES_PASSWORD=
# (선택) GitHub 연동용 토큰
# GITHUB_TOKEN=

# MCP 클라이언트용 정적 토큰 (app-config.mcp.example.yaml 을 app-config.local.yaml 로 복사해 쓸 때 필요)
# MCP_TOKEN=
