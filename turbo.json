{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "globalDependencies": [
    "yarn.lock",
    "tsconfig.json",
    ".eslintrc.js",
    ".prettierrc*",
    "app-config*.yaml"
  ],
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["CI"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-types/**"]
    }
  }
}
